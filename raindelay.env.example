# Location
LATITUDE=40.7128
LONGITUDE=-74.0060

# IANA timezone string — used for midnight calculation and Open-Meteo daily aggregation
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TIMEZONE=America/New_York

# Minimum forecasted precipitation (inches) to activate the relay (default: 0.1)
# Set to 0 to force activation for testing
RAINFALL_THRESHOLD_INCHES=0.1

# Tinytuya device credentials
# Run `python3 -m tinytuya wizard` to discover your device's ID, IP, and local key
TUYA_DEV_ID=your_device_id
TUYA_IP=192.168.1.xxx
TUYA_LOCAL_KEY=your_local_key

# Tinytuya protocol version (default: 3.5)
TUYA_VERSION=3.5
